{
  "entities": {
    "UserWorkspace": {
      "title": "UserWorkspace",
      "description": "Root workspace metadata for an authenticated user (non-PII).",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the workspace owner.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Display name shown in the workspace.",
          "minLength": 1,
          "maxLength": 100
        },
        "seededDefaults": {
          "type": "boolean",
          "description": "Whether initial sample projects and tasks have been seeded."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when workspace was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when workspace was last updated."
        }
      },
      "required": ["userId", "displayName", "seededDefaults", "createdAt", "updatedAt"]
    },
    "UserPrivateProfile": {
      "title": "UserPrivateProfile",
      "description": "PII-isolated private profile information for the user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the profile owner.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified email address of the user.",
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "description": "User full name.",
          "minLength": 1,
          "maxLength": 100
        },
        "theme": {
          "type": "string",
          "enum": ["light", "dark"],
          "description": "Preferred UI color theme."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "email", "displayName", "theme", "createdAt", "updatedAt"]
    },
    "Project": {
      "title": "Project",
      "description": "A project bucket used to organize and filter tasks.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "color": {
          "type": "string",
          "maxLength": 7,
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "name", "color", "createdAt", "updatedAt"]
    },
    "Task": {
      "title": "Task",
      "description": "A task item with project, category, priority, status, due date, and bounded tags.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        },
        "project": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "enum": ["feature", "bug", "migration", "design", "ops", "content", "security", "research"]
        },
        "priority": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "status": {
          "type": "string",
          "enum": ["backlog", "progress", "review", "done"]
        },
        "due": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^(|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
        },
        "tags": {
          "type": "array",
          "description": "Up to 10 short tag strings attached to the task."
        },
        "subtasks": {
          "type": "array",
          "description": "Up to 15 actionable sub-task items ({id, title, done})."
        },
        "archived": {
          "type": "boolean",
          "description": "Whether a completed task has been archived (auto-archived after 30 days in done)."
        },
        "assignee": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "title", "notes", "project", "category", "priority", "status", "due", "tags", "assignee", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A multi-turn conversation message with optional search grounding sources.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["user", "model"]
        },
        "persona": {
          "type": "string",
          "enum": ["strategist", "researcher", "triage"]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "sources": {
          "type": "array",
          "description": "Up to 10 grounded web source references."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "role", "persona", "text", "sources", "createdAt"]
    },
    "ActivityEvent": {
      "title": "ActivityEvent",
      "description": "An immutable audit entry tracking task updates, status changes, deletions, and project creation.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "action": {
          "type": "string",
          "enum": ["task_created", "task_updated", "task_status_changed", "task_deleted", "project_created"]
        },
        "entityType": {
          "type": "string",
          "enum": ["task", "project"]
        },
        "entityId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "entityTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "fromStatus": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^(|backlog|progress|review|done)$"
        },
        "toStatus": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^(|backlog|progress|review|done)$"
        },
        "projectId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^(|[a-zA-Z0-9_\\-]+)$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "action", "entityType", "entityId", "entityTitle", "summary", "fromStatus", "toStatus", "projectId", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserWorkspace" },
      "description": "Workspace root document owned by userId."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateProfile" },
      "description": "PII-isolated private profile document (docId is 'profile')."
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "User's task projects."
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "User's tasks with category, priority, status, and tags."
    },
    "/users/{userId}/chatMessages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Multi-turn Gemini assistant messages for the user."
    },
    "/users/{userId}/activityLog/{eventId}": {
      "schema": { "$ref": "#/entities/ActivityEvent" },
      "description": "Append-only user activity log tracking task updates, status changes, and project creation."
    }
  }
}
