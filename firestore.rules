rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------- Global Primitives ----------------
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ---------------- Entity Validators ----------------
    function isValidWorkspace(data, userId) {
      return data.keys().hasAll(['userId', 'displayName', 'seededDefaults', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'displayName', 'seededDefaults', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && isValidId(data.userId)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.seededDefaults is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateProfile(data, userId) {
      return data.keys().hasAll(['userId', 'email', 'displayName', 'theme', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'email', 'displayName', 'theme', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && isValidId(data.userId)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.theme in ['light', 'dark']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProject(data, projectId, userId) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'color', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'name', 'color', 'createdAt', 'updatedAt'])
        && data.id == projectId
        && isValidId(data.id)
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && data.color is string && data.color.size() == 7 && data.color.matches('^#[0-9A-Fa-f]{6}$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTags(tags) {
      return tags is list
        && tags.size() <= 10
        && (tags.size() == 0 || (tags[0] is string && tags[0].size() >= 1 && tags[0].size() <= 32));
    }

    function isValidSubtasks(subtasks) {
      return subtasks is list
        && subtasks.size() <= 15
        && (subtasks.size() == 0 || (
          subtasks[0] is map
          && subtasks[0].keys().hasAll(['id', 'title', 'done'])
          && subtasks[0].keys().hasOnly(['id', 'title', 'done'])
          && isValidId(subtasks[0].id)
          && subtasks[0].title is string && subtasks[0].title.size() >= 1 && subtasks[0].title.size() <= 120
          && subtasks[0].done is bool
        ));
    }

    function isValidTask(data, taskId, userId) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'notes', 'project', 'category', 'priority', 'status', 'due', 'tags', 'assignee', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'title', 'notes', 'project', 'category', 'priority', 'status', 'due', 'tags', 'subtasks', 'archived', 'assignee', 'createdAt', 'updatedAt'])
        && data.id == taskId
        && isValidId(data.id)
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.notes is string && data.notes.size() <= 2000
        && isValidId(data.project)
        && data.category in ['feature', 'bug', 'migration', 'design', 'ops', 'content', 'security', 'research']
        && data.priority in ['high', 'medium', 'low']
        && data.status in ['backlog', 'progress', 'review', 'done']
        && data.due is string && data.due.size() <= 10 && data.due.matches('^(|[0-9]{4}-[0-9]{2}-[0-9]{2})$')
        && isValidTags(data.tags)
        && (!('subtasks' in data) || isValidSubtasks(data.subtasks))
        && (!('archived' in data) || data.archived is bool)
        && data.assignee is string && data.assignee.size() >= 1 && data.assignee.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSources(sources) {
      return sources is list
        && sources.size() <= 10
        && (sources.size() == 0 || (
          sources[0] is map
          && sources[0].keys().hasAll(['title', 'uri'])
          && sources[0].keys().hasOnly(['title', 'uri'])
          && sources[0].title is string && sources[0].title.size() <= 200
          && sources[0].uri is string && sources[0].uri.size() <= 1000
        ));
    }

    function isValidChatMessage(data, messageId, userId) {
      return data.keys().hasAll(['id', 'ownerId', 'role', 'persona', 'text', 'sources', 'createdAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'role', 'persona', 'text', 'sources', 'createdAt'])
        && data.id == messageId
        && isValidId(data.id)
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.role in ['user', 'model']
        && data.persona in ['strategist', 'researcher', 'triage']
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 12000
        && isValidSources(data.sources)
        && data.createdAt is timestamp;
    }

    function isValidActivityEvent(data, eventId, userId) {
      return data.keys().hasAll(['id', 'ownerId', 'action', 'entityType', 'entityId', 'entityTitle', 'summary', 'fromStatus', 'toStatus', 'projectId', 'createdAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'action', 'entityType', 'entityId', 'entityTitle', 'summary', 'fromStatus', 'toStatus', 'projectId', 'createdAt'])
        && data.id == eventId
        && isValidId(data.id)
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.action in ['task_created', 'task_updated', 'task_status_changed', 'task_deleted', 'project_created']
        && data.entityType in ['task', 'project']
        && isValidId(data.entityId)
        && data.entityTitle is string && data.entityTitle.size() >= 1 && data.entityTitle.size() <= 160
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 280
        && data.fromStatus is string && data.fromStatus.size() <= 20 && data.fromStatus.matches('^(|backlog|progress|review|done)$')
        && data.toStatus is string && data.toStatus.size() <= 20 && data.toStatus.matches('^(|backlog|progress|review|done)$')
        && data.projectId is string && data.projectId.size() <= 128 && data.projectId.matches('^(|[a-zA-Z0-9_\\-]+)$')
        && data.createdAt is timestamp;
    }

    // ---------------- Workspace & Collections ----------------
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidWorkspace(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidWorkspace(incoming(), userId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'seededDefaults', 'updatedAt']);
      allow delete: if false;

      match /private/{docId} {
        allow get: if isValidId(userId) && docId == 'profile' && isOwner(userId);
        allow list: if false;
        allow create: if isValidId(userId)
          && docId == 'profile'
          && isOwner(userId)
          && isValidPrivateProfile(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && docId == 'profile'
          && isOwner(userId)
          && isValidPrivateProfile(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'theme', 'email', 'updatedAt']);
        allow delete: if false;
      }

      match /projects/{projectId} {
        allow get: if isValidId(userId) && isValidId(projectId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(projectId)
          && isOwner(userId)
          && isValidProject(incoming(), projectId, userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(projectId)
          && isOwner(userId)
          && isValidProject(incoming(), projectId, userId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'color', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(projectId) && isOwner(userId);
      }

      match /tasks/{taskId} {
        allow get: if isValidId(userId) && isValidId(taskId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(taskId)
          && isOwner(userId)
          && isValidTask(incoming(), taskId, userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && existsAfter(/databases/$(database)/documents/users/$(userId)/projects/$(incoming().project));
        allow update: if isValidId(userId)
          && isValidId(taskId)
          && isOwner(userId)
          && isValidTask(incoming(), taskId, userId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && existsAfter(/databases/$(database)/documents/users/$(userId)/projects/$(incoming().project))
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'archived', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['archived', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['subtasks', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'notes', 'project', 'category', 'priority', 'status', 'due', 'tags', 'subtasks', 'archived', 'assignee', 'updatedAt'])
          );
        allow delete: if isValidId(userId) && isValidId(taskId) && isOwner(userId);
      }

      match /chatMessages/{messageId} {
        allow get: if isValidId(userId) && isValidId(messageId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(messageId)
          && isOwner(userId)
          && isValidChatMessage(incoming(), messageId, userId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(messageId) && isOwner(userId);
      }

      match /activityLog/{eventId} {
        allow get: if isValidId(userId) && isValidId(eventId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(eventId)
          && isOwner(userId)
          && isValidActivityEvent(incoming(), eventId, userId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(eventId) && isOwner(userId);
      }
    }
  }
}
